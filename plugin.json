{
  "apiVersion": 1,
  "requires": {
    "pluginApi": "3.0.0"
  },
  "id": "eidos.chart",
  "name": "Chart",
  "version": "0.4.0",
  "icon": {
    "paths": [
      "M3 3v18h18",
      "M7 16v-5",
      "M12 16V7",
      "M17 16v-8"
    ]
  },
  "views": [
    {
      "id": "chart",
      "title": "Chart",
      "entry": "./src/view.tsx",
      "access": "read",
      "icon": {
        "paths": [
          "M3 3v16a2 2 0 0 0 2 2h16",
          "m19 9-5 5-4-4-3 3"
        ]
      },
      "configuration": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "title": "Chart type",
            "default": "Column",
            "enum": [
              "Column",
              "Bar",
              "Line",
              "Donut",
              "Number",
              "Colored Calendar"
            ]
          },
          "group": {
            "type": "string",
            "title": "Group by",
            "default": "",
            "x-field": true,
            "description": "Chart: the category field. Colored Calendar: the date field that places each entry on a day."
          },
          "value": {
            "type": "string",
            "title": "Value field",
            "default": "",
            "x-field": true,
            "description": "Numeric field (number, rating or numeric Formula) used by Sum, Average, Minimum and Maximum. Not needed for Count."
          },
          "aggregate": {
            "type": "string",
            "title": "Calculate",
            "default": "Count",
            "enum": [
              "Count",
              "Sum",
              "Average",
              "Minimum",
              "Maximum"
            ],
            "description": "Colored Calendar colors each day by this result."
          },
          "date": {
            "type": "string",
            "title": "Date grouping (UTC)",
            "default": "Exact",
            "enum": [
              "Exact",
              "Day",
              "Month",
              "Year"
            ]
          },
          "sort": {
            "type": "string",
            "title": "Sort",
            "default": "Label",
            "enum": [
              "Label",
              "Value descending",
              "Value ascending"
            ]
          },
          "legend": {
            "type": "boolean",
            "title": "Show legend",
            "default": true
          },
          "timezone": {
            "type": "string",
            "title": "Calendar day timezone",
            "default": "Local",
            "enum": [
              "Local",
              "UTC"
            ],
            "description": "Colored Calendar only: decides which day a date/time entry belongs to."
          },
          "color": {
            "type": "string",
            "title": "Colored Calendar color",
            "default": "Blue",
            "enum": [
              "Blue",
              "Green",
              "Yellow",
              "Orange",
              "Red",
              "Pink",
              "Purple",
              "Brown",
              "Gray"
            ],
            "description": "Base color of the Colored Calendar scale."
          }
        }
      },
      "kind": "file",
      "capabilities": [
        "eidos/table"
      ]
    }
  ],
  "placements": [
    {
      "location": "table/view",
      "view": "chart"
    }
  ]
}
